.venv/
__pycache__/
*.pyc
.DS_Store
.claude/

# Vendored repos, cloned by the notebook's own Section 0 -- re-clonable, not ours to version
FSC-inference-MAPSO/
tinyRNN/

# Per-run logs from scripts/train_rnn_parallel.py
train_*.log

# FSC val/test loss sidecars (§2.1) -- a local cache regenerated in seconds from the
# committed .pkl fits + the current split, so not worth versioning.
fitted_models/**/fsc/**/*.losses.json
fitted_models_ts/**/fsc/**/*.losses.json

# Regenerable RNN-training and investigation outputs, used only by the superseded pipeline
# notebooks. Re-run training to recreate them; only the FSC fits are versioned.
fitted_models/*/rnn/exp_*_l1-0/
fitted_models/ts/rnn/
fitted_models/*/investigation/
fitted_models/ts/fsc/sweep/
